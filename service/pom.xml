<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
  xin.ai 父 POM（M2-01）
  约定：JDK 17 / Spring Boot 3.5.x / MyBatis-Plus 3.5.x / Maven 3.9
  子模块：common / domain / model-adapters / api / worker
  行内注释1：dependencyManagement 锁版本，子模块只声明 artifact 不写版本
  行内注释2：api 与 worker 打 fat jar，其余打普通 jar
  TODO(SPEC): 虚拟线程等 Java21 特性推迟到二期，当前禁用
============================================================ -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.xin.ai</groupId>
  <artifactId>xin-ai-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>xin.ai parent</name>

  <modules>
    <module>common</module>
    <module>domain</module>
    <module>model-adapters</module>
    <module>api</module>
    <module>worker</module>
  </modules>

  <properties>
    <!-- 行内注释3：JDK 基线 17，用户明确要求，不用 21 -->
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 行内注释4：必须开启 -parameters —— 否则 Spring 无法推断 @PathVariable / @RequestParam 的参数名，
         运行期会抛 "Name for argument of type ... not specified"。 -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <spring-boot.version>3.5.0</spring-boot.version>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <redisson.version>3.36.0</redisson.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <caffeine.version>3.1.8</caffeine.version>
    <flyway.version>10.15.0</flyway.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-boot-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${redisson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.ben-manes.caffeine</groupId>
        <artifactId>caffeine</artifactId>
        <version>${caffeine.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- 行内注释5：必须显式声明编译插件 —— pluginManagement 只在子模块声明该插件时才生效，
           否则用的是 Maven super-POM 的老版本默认（不认 -parameters），
           运行期 Spring 无法推断 @PathVariable / @RequestParam 的参数名。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
